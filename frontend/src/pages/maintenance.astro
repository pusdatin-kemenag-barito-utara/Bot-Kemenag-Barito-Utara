---
const pusdatinUrl = import.meta.env.PUBLIC_PUSDATIN_URL || "";
const appId = import.meta.env.PUBLIC_PUSDATIN_APP_ID || "";
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="pusdatin-url" content={pusdatinUrl} />
    <meta name="pusdatin-app-id" content={appId} />
    <title>Sistem Sedang Pemeliharaan — Bot PTSP Kemenag Barito Utara</title>
    <link rel="icon" href="/logo.kemenag.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <style>
      *, *::before, *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html, body {
        width: 100%;
        height: 100%;
        margin: 0;
        padding: 0;
        overflow: hidden;
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        background-color: #f8fafc;
      }
      .maintenance-iframe {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        border: none;
        outline: none;
        display: block;
        z-index: 99999;
        background-color: #f8fafc;
      }
      .fallback-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 24px;
        text-align: center;
        background-color: #f8fafc;
      }
      .fallback-icon {
        width: 80px;
        height: 80px;
        margin-bottom: 24px;
        border-radius: 24px;
        background: rgba(245, 158, 11, 0.1);
        border: 1px solid rgba(245, 158, 11, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #d97706;
        font-size: 32px;
        box-shadow: 0 10px 25px -5px rgba(245, 158, 11, 0.2);
      }
      .fallback-title {
        font-size: 28px;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: #0f172a;
        margin-bottom: 12px;
      }
      .fallback-desc {
        font-size: 15px;
        color: #475569;
        max-width: 480px;
        margin-bottom: 28px;
        line-height: 1.6;
      }
      .fallback-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: 9999px;
        background: #e2e8f0;
        border: 1px solid #cbd5e1;
        font-size: 12px;
        font-weight: 600;
        color: #334155;
      }
      .pulse-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: #f59e0b;
        animation: pulse 1.5s infinite;
      }
      @keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.85); }
      }
    </style>
  </head>
  <body>
    {pusdatinUrl ? (
      <iframe
        src={`${pusdatinUrl}/maintenance?app=Bot+Kemenag`}
        title="Sistem Sedang Pemeliharaan"
        class="maintenance-iframe"
      />
    ) : (
      <div class="fallback-container">
        <div class="fallback-icon">
          <i class="fa-solid fa-screwdriver-wrench"></i>
        </div>
        <h1 class="fallback-title">
          Sistem Sedang Dalam Pemeliharaan
        </h1>
        <p class="fallback-desc">
          Layanan Bot PTSP Kemenag Barito Utara saat ini sedang dalam proses pemeliharaan berkala oleh tim Pusdatin untuk peningkatan kualitas layanan.
        </p>
        <div class="fallback-badge">
          <span class="pulse-dot"></span>
          Status diperiksa otomatis secara berkala
        </div>
      </div>
    )}

    <script is:inline>
      const PUSDATIN_URL = document.querySelector('meta[name="pusdatin-url"]')?.getAttribute('content') || '';
      const APP_ID = document.querySelector('meta[name="pusdatin-app-id"]')?.getAttribute('content') || '';

      async function checkRestored() {
        if (!PUSDATIN_URL || !APP_ID) return;
        try {
          const res = await fetch(PUSDATIN_URL + "/api/public/apps/" + APP_ID + "/status?_t=" + Date.now());
          if (res.ok) {
            const data = await res.json();
            if (data && data.status !== "maintenance") {
              sessionStorage.removeItem("is_maintenance");
              window.location.replace("/");
            }
          }
        } catch (_) {}
      }

      if (PUSDATIN_URL && APP_ID) {
        setInterval(checkRestored, 10000);
        window.addEventListener("focus", checkRestored);
      }
    </script>
  </body>
</html>
