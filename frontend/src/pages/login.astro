---
import LoginApp from '../components/LoginApp';
import MaintenanceListener from '../components/layout/MaintenanceListener';
import '../styles/global.css';

const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN || "";
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="cf-beacon-token" content={cfBeaconToken} />
    <title>Login Admin — Bot PTSP Kemenag Barito Utara</title>
    <link rel="icon" href="/logo.kemenag.svg" type="image/svg+xml" />
    <!-- Resource Hints & Priority Hints -->
    <link rel="dns-prefetch" href="//fonts.googleapis.com" />
    <link rel="dns-prefetch" href="//fonts.gstatic.com" />
    <link rel="dns-prefetch" href="//cdnjs.cloudflare.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />

    <!-- Open Graph Meta Tags (WhatsApp, Telegram, Facebook) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PTSP Kemenag Barito Utara" />
    <meta property="og:title" content="Login Admin — Bot PTSP Kemenag Barito Utara" />
    <meta property="og:description" content="Autentikasi Administrator Pelayanan Terpadu Satu Pintu (PTSP) Kantor Kementerian Agama Kabupaten Barito Utara." />
    <meta property="og:image" content="/logo.kemenag.svg" />
    <meta property="og:image:alt" content="Logo Kementerian Agama Republik Indonesia" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Login Admin — Bot PTSP Kemenag Barito Utara" />
    <meta name="twitter:description" content="Autentikasi Administrator Portal PTSP Kemenag Barito Utara." />
    <meta name="twitter:image" content="/logo.kemenag.svg" />

    <!-- PWA & Mobile Web App Meta -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/logo.kemenag.svg" />
    <meta name="theme-color" content="#0d1527" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="PTSP Kemenag" />
    <meta name="application-name" content="PTSP Kemenag Barito Utara" />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <script is:inline>
      // Daftarkan Service Worker PWA
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function() {
          navigator.serviceWorker.register('/sw.js', { scope: '/' })
            .catch(function(err) { console.warn('[PWA] SW register error:', err); });
        });
      }

      // Cloudflare Real User Monitoring (RUM) & Core Web Vitals Beacon
      (function() {
        if (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') return;
        var token = document.querySelector('meta[name="cf-beacon-token"]')?.getAttribute('content');
        if (!token) return;
        var cfScript = document.createElement('script');
        cfScript.defer = true;
        cfScript.src = 'https://static.cloudflareinsights.com/beacon.min.js';
        cfScript.setAttribute('data-cf-beacon', JSON.stringify({ token: token }));
        document.head.appendChild(cfScript);
      })();
      if (sessionStorage.getItem("is_maintenance") === "true") {
        window.location.replace("/maintenance");
      }
    </script>
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
  </head>
  <body>
    <LoginApp client:load />
    <MaintenanceListener client:load />
  </body>
</html>