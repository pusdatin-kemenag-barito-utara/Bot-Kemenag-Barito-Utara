# ==============================================================================
# Environment Configuration Example — Bot PTSP Kemenag Barito Utara
# Catatan: Variabel ini dikelola oleh Infisical di lingkungan staging/produksi.
# File ini digunakan sebagai panduan atau referensi untuk pengujian lokal (.env).
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Settings
# ------------------------------------------------------------------------------
PORT=8080
LOG_HTTP_REQUESTS=1

# ------------------------------------------------------------------------------
# Database Settings (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# URL koneksi PostgreSQL lengkap (mendukung sslmode=require / disable)
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/postgres?sslmode=disable

# Nama skema PostgreSQL untuk tabel-tabel bot (wa_contacts, wa_message_logs, dll.)
DB_SCHEMA=kemenag_bot

# Nama skema PostgreSQL untuk tabel antrean outbox PTSP (ptsp_whatsapp_outbox)
OUTBOX_SCHEMA=kemenag_ptsp

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# Kunci rahasia untuk enkripsi cookie sesi (wajib diisi, minimal 32 karakter acak)
SESSION_SECRET=ganti-dengan-kunci-rahasia-sesi-acak-yang-panjang-dan-kuat-32-karakter

# Kredensial login admin dashboard
ADMIN_USERNAME=admin
# Hash kata sandi admin (gunakan format argon2id atau bcrypt)
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$...
# Fallback plaintext jika hash tidak diisi (hanya untuk pengujian dev lokal)
# ADMIN_PASSWORD=admin_password_rahasia

# API Key untuk integrasi sistem eksternal mengirim pesan via POST /api/send
API_KEY=kemenag_ptsp_secret_api_key_here

# ------------------------------------------------------------------------------
# Cloudflare Turnstile (Anti-Bot / Captcha Login)
# ------------------------------------------------------------------------------
TURNSTILE_SITE_KEY=0x4AAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAA...

# ------------------------------------------------------------------------------
# Anti-Ban & WhatsApp Rate Limits
# ------------------------------------------------------------------------------
# Batas maksimal pengiriman pesan keluar per hari
MAX_DAILY_OUTBOUND=1500

# ------------------------------------------------------------------------------
# Webhook & Workflow Integrations
# ------------------------------------------------------------------------------
# URL webhook n8n untuk meneruskan pesan masuk ke otomasi alur kerja
N8N_WEBHOOK_URL=
